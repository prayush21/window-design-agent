# Copy to .env (scripts\windows\setup.ps1 does this for you), then fill in the API keys.

# --- Access: the tunnel URL is public, so everything remote sits behind this ---
# setup.ps1 generates a passcode. Share it with your testers.
ACCESS_PASSCODE=
# Paid runs allowed per day across everyone / per visitor (0 = no limit). Each live run
# costs roughly $0.30-0.60, mostly image renders.
DAILY_RUN_LIMIT=30
PER_IP_DAILY_LIMIT=10

# --- Server: loopback only; the tunnel is the only way in from outside ---
HOST=127.0.0.1
PORT=3001

# --- Catalog (relative to the repo root). setup.ps1 sets this if the folder exists ---
DESIGN_AGENT_CATALOG_DIR=Product Catalog V2-clean

# --- Models ---
DESIGN_AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# Live = real (paid) model calls. Set to 0 for mock fixtures that cost nothing.
DESIGN_AGENT_LIVE=1
V2_RENDER_PROVIDER=gemini
V2_RENDER_MODEL=gemini-3.1-flash-image
V2_CRITIQUE_PROVIDER=gemini
V2_CRITIQUE_MODEL=gemini-3.1-pro-preview
